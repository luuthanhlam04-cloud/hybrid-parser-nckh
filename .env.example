PROJECT_NAME=hybrid_parser_graphrag
ENVIRONMENT=development

RAW_DATA_DIR=datasets/raw_laws
CLEAN_TEXT_DIR=outputs/clean_texts
PHYSICAL_GRAPH_DIR=outputs/physical_graphs
CANDIDATE_NODE_DIR=outputs/candidate_nodes
SEMANTIC_GRAPH_DIR=outputs/semantic_graphs
UNIFIED_GRAPH_DIR=outputs/unified_graphs
EVALUATION_DIR=outputs/evaluation_reports

REGEX_PATTERN_FILE=configs/regex_patterns.yaml
ONTOLOGY_SCHEMA_FILE=configs/ontology_schema.json
PROMPT_TEMPLATE_FILE=configs/prompt_templates.json

NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

LLM_API_KEY=
LLM_MODEL=

EMBEDDING_MODEL=
ROUTING_THRESHOLD=
# Benchmark B optional separate keys (same OpenRouter account is acceptable).
OPENROUTER_HYBRID_BENCHMARK_KEY=
OPENROUTER_LIGHTRAG_BENCHMARK_KEY=

# Module 10 — Jev-assisted AUTO-FUSION
JEV_ENABLED=true
JEV_MODEL=typesafe/jev-1.14
JEV_API_URL=https://openrouter.ai/api/alpha/decisions
JEV_TIMEOUT_SECONDS=15
JEV_MAX_RETRIES=3
JEV_ROUTE_ACTIVATE_THRESHOLD=0.60
JEV_ROUTE_UNCERTAIN_THRESHOLD=0.40
JEV_REFERENCE_ROUTE_THRESHOLD=0.35
JEV_EVIDENCE_KEEP_THRESHOLD=0.45
JEV_ANSWERABILITY_THRESHOLD=0.70
